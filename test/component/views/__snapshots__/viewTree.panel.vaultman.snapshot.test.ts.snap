// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`viewTree - panel x vaultman snapshot > row root + inner + label + state mods + badges render under default vaultman mask 1`] = `"<div class="vm-tree-virtual-outer" role="tree" aria-multiselectable="true" tabindex="-1" style="--vm-node-grid-tile-w: 128px; --vm-node-grid-tile-h: 72px; --vm-node-grid-icon-size: 24px; --vm-node-grid-label-lines: 1; --vm-node-grid-gap: 8px; --vm-tree-row-h: 28px; --vm-tree-icon-size: 16px; --vm-tree-toggle-size: 20px;"><!----> <div class="vm-tree-virtual-inner" style="--vm-tree-total-h: 56px;"><div class="vm-tree-virtual-row    vm-is-selected vm-is-focused is-selected is-focused" style="--vm-tree-y: 0px; --depth: 0;" data-id="tree-alpha" data-index="0" data-vm-virtual-index="0" data-vm-total-rows="2" role="treeitem" tabindex="0" aria-selected="true" aria-expanded="true" data-row-key="tree-alpha"><div data-vm-node-row="" class="vm-tree-row-surface vm-is-selected vm-is-focused is-selected is-focused has-toggle has-icon has-count has-overlay-badges is-expanded-parent"><!----> <!----><!----><!----> <div class="vm-tree-toggle " role="button" tabindex="-1" aria-hidden="true"><span></span></div><!----><!----> <span data-vm-icon="" class="vm-tree-icon"></span><!----> <span data-vm-label="" class="vm-tree-label"><!----><!----><!---->Alpha<!----></span><!----> <!----> <!----> <!----> <div class="vm-tree-badge-zone has-count has-overlay-badges"><div data-vm-badges="" class="vm-tree-overlay-badge-zone has-active-badges"><!----> <!----><div role="button" data-vm-badge="" class="vm-badge is-solid is-undoable is-actionable" title="Queued - click to remove from queue" aria-label="Queued - click to remove from queue" tabindex="0"><!----></div><!----> <!----></div><!----> <span data-vm-count="" class="vm-tree-count">2</span><!----></div><!----> <!----></div><!----></div><div class="vm-tree-virtual-row    " style="--vm-tree-y: 28px; --depth: 1;" data-id="tree-beta" data-index="1" data-vm-virtual-index="1" data-vm-total-rows="2" role="treeitem" tab