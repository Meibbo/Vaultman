{
	"name": "vaultman",
	"version": "2.0.0-alpha.1",
	"description": "Files, content and frontmatter explorer like Bases with scoped queued changes list.",
	"keywords": [],
	"license": "Apache-2.0",
	"author": "Meibbo",
	"type": "module",
	"main": "main.js",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "vp build --watch",
		"build": "tsc -noEmit -skipLibCheck && vp build && node scripts/sync-test-build.mjs",
		"build:plugin": "tsc -noEmit -skipLibCheck && vp build",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "vp lint && eslint .",
		"lint:fast": "vp lint",
		"lint:full": "eslint .",
		"format": "vp run format:ox && vp run format:prettier",
		"format:check": "vp run format:ox:check && vp run format:prettier:check",
		"format:ox": "vp fmt",
		"format:ox:check": "vp fmt --check",
		"format:prettier": "prettier --write \"**/*.svelte\"",
		"format:prettier:check": "prettier --check \"**/*.svelte\"",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test:integrity": "vp test run --project integration --config vitest.config.ts",
		"test:unit": "vp test run --project unit --config vitest.config.ts",
		"test:component": "vp test run --project component --config vitest.config.ts --fileParallelism=false",
		"test:cover": "vp test run --project unit --coverage --config vitest.config.ts",
		"test:e2e": "wdio run ./wdio.conf.mts",
		"test:all": "vp run test:integrity && vp run test:e2e",
		"verify": "vp run lint && vp run check && vp run build && vp run test:unit && vp run test:component",
		"smoke:scroll": "node scripts/run-explorer-scroll-smoke.mjs --mode=smoke",
		"smoke:scroll:stress": "node scripts/run-explorer-scroll-smoke.mjs --mode=stress",
		"security:audit": "node scripts/security-audit.mjs --scope=prod --report-level=moderate --fail-level=high && node scripts/security-audit.mjs --scope=dev --report-level=moderate --fail-level=high",
		"sbom:release": "node scripts/generate-release-sbom.mjs",
		"audit:dead-exports": "ts-prune",
		"audit:knip": "knip --reporter compact",
		"audit:depcheck": "depcheck --ignores=\"@types/*,obsidian-integration-testing,wdio-obsidian-service\"",
		"audit:all": "pnpm run audit:dead-exports ; pnpm run audit:knip ; pnpm run audit:depcheck"
	},
	"devDependencies": {
		"@cyclonedx/cdxgen": "12.4.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tanstack/svelte-virtual": "3.13.24",
		"@tanstack/table-core": "8.21.3",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^26.0.0",
		"@vitest/coverage-v8": "^4.1.9",
		"@wdio/cli": "^9.29.0",
		"@wdio/globals": "^9.29.0",
		"@wdio/local-runner": "^9.29.0",
		"@wdio/mocha-framework": "^9.29.0",
		"@wdio/spec-reporter": "^9.29.0",
		"depcheck": "^1.4.7",
		"esbuild": "^0.28.0",
		"esbuild-sass-plugin": "^3.7.0",
		"esbuild-svelte": "^0.9.4",
		"eslint": "^10.5.0",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"eslint-plugin-oxlint": "^1.70.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "17.6.0",
		"jiti": "2.6.1",
		"js-yaml": "^4.1.1",
		"jsdom": "^29.1.1",
		"knip": "^6.8.0",
		"mocha": "^11.7.6",
		"obsidian": "1.13.1",
		"obsidian-integration-testing": "^4.2.6",
		"obsidian-launcher": "^3.1.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.1",
		"sass": "^1.81.0",
		"svelte": "^5.56.3",
		"svelte-check": "^4.1.0",
		"svelte-preprocess": "^6.0.3",
		"ts-prune": "^0.10.3",
		"type-fest": "^5.7.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.61.1",
		"unocss-preset-theme": "^0.14.1",
		"vite-plus": "^0.2.1",
		"vitest": "^4.1.9",
		"wdio-obsidian-reporter": "^3.1.1",
		"wdio-obsidian-service": "^3.1.1"
	},
	"packageManager": "pnpm@11.1.2",
	"dependencies": {
		"@chenglou/pretext": "^0.0.8",
		"@dnd-kit/svelte": "^0.5.0",
		"@git-diff-view/svelte": "^0.1.5",
		"@unocss/vite": "^66.7.2",
		"bits-ui": "^2.18.1",
		"unocss": "^66.7.2"
	}
}
