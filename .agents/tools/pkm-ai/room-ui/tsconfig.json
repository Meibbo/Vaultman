{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "strict": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "types": ["node", "svelte"]
  },
  "include": ["server.ts", "src/**/*.ts", "test/**/*.mjs", "vite.config.ts"]
}
