{
  "name": "vaultman-pkm-ai-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "health": "node check-doc-health.ts",
    "index": "node index-docs.ts",
    "embed": "node embed-docs.ts",
    "query": "node query-docs.ts",
    "metric": "node record-metric.ts",
    "archive": "node archive-active-doc.mjs",
    "update": "node update-indexes.mjs",
    "shard": "node shard-index.mjs",
    "split-shard": "node split-shard.ts",
    "code-index": "node code-index.mjs",
    "room": "node agent-room.ts",
    "tasks": "node manage-tasks.ts",
    "room-ui:build": "cd room-ui && node scripts/run-tool.mjs vite build",
    "room-ui:dev": "cd room-ui && node server.ts --host 127.0.0.1",
    "room-ui:dev:lan": "cd room-ui && node server.ts --lan",
    "room-ui:test": "cd room-ui && node --test \"test/*.test.mjs\"",
    "room-ui:typecheck": "cd room-ui && node scripts/run-tool.mjs tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "bin": {
    "pkm": "./pkm.ts",
    "pkm-ai-health": "./check-doc-health.ts",
    "pkm-ai-index": "./index-docs.ts",
    "pkm-ai-embed": "./embed-docs.ts",
    "pkm-ai-query": "./query-docs.ts",
    "pkm-ai-metric": "./record-metric.ts",
    "pkm-ai-archive": "./archive-active-doc.mjs",
    "pkm-ai-update": "./update-indexes.mjs",
    "pkm-ai-shard": "./shard-index.mjs",
    "pkm-ai-split-shard": "./split-shard.ts",
    "pkm-ai-code-index": "./code-index.mjs",
    "pkm-ai-room": "./agent-room.ts",
    "pkm-ai-tasks": "./manage-tasks.ts"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@unocss/preset-wind4": "^66.7.0",
    "bits-ui": "^2.18.1",
    "daisyui": "^5.5.23",
    "svelte": "^5.56.2",
    "unocss": "^66.7.0",
    "vite": "^8.0.16"
  }
}
