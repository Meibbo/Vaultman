		{"id":"0718a1f2c3d4e5b6","type":"group","x":-510,"y":-60,"width":470,"height":740,"label":"Authoring tipado (B)","color":"6"},
		{"id":"1829b2e3d4c5f6a7","type":"text","x":-480,"y":-20,"width":410,"height":70,"text":"**style** — pseudo-snippets + tokens `--vm-*`"},
		{"id":"293ac3d4e5f6a7b8","type":"text","x":-480,"y":65,"width":410,"height":60,"text":"**layout** — bars / dock / tiles"},
		{"id":"3a4bd4e5f6a7b8c9","type":"text","x":-480,"y":140,"width":410,"height":60,"text":"**load** — LUPA on/off (debloat)"},
		{"id":"4b5ce5f6a7b8c9d0","type":"text","x":-480,"y":215,"width":410,"height":70,"text":"**view** — engine / mode / orientation / cells"},
		{"id":"5c6df6a7b8c9d0e1","type":"text","x":-480,"y":300,"width":410,"height":60,"text":"**workspace** — panel tree / tiles"},
		{"id":"6d7ea7b8c9d0e1f2","type":"text","x":-480,"y":375,"width":410,"height":60,"text":"**input** — NIB (kbd/mouse/touch)"},
		{"id":"7e8fb8c9d0e1f2a3","type":"text","x":-480,"y":460,"width":410,"height":90,"color":"3","text":"**Profile** = composición nombrada de facetas.\nBuilt-ins: barebones · native · polish · custom"},
		{"id":"8f90c9d0e1f2a3b4","type":"text","x":-480,"y":570,"width":410,"height":90,"color":"3","text":"**.scene** — layered-YAML, se comparte como `.base` (CR-2; payload = lo define este grill)"},
		{"id":"90a1d0e1f2a3b4c5","type":"group","x":-10,"y":-60,"width":410,"height":640,"label":"Resolución en cascada (C)","color":"6"},
		{"id":"a1b2e1f2a3b4c5d6","type":"text","x":10,"y":-20,"width":350,"height":55,"text":"**Global** (vault/plugin defaults)"},
		{"id":"b2c3f2a3b4c5d6e7","type":"text","x":10,"y":55,"width":350,"height":55,"text":"**Workspace / Profile**"},
		{"id":"c3d4a3b4c5d6e7f8","type":"text","x":10,"y":130,"width":350,"height":55,"text":"**Surface** (tab · modal · popup · codeblock)"},
		{"id":"d4e5b4c5d6e7f809","type":"text","x":10,"y":205,"width":350,"height":55,"text":"**Scene** (filterScene, queueScene…)"},
		{"id":"e5f6c5d6e7f8091a","type":"text","x":10,"y":280,"width":350,"height":55,"text":"**Panel** (engine + provider + config)"},
		{"id":"f6a7d6e7f8091a2b","type":"text","x":10,"y":355,"width":350,"height":70,"text":"**Level / Parent / Node** — levelViews · parentViews · xyz · layers · icon override"},
		{"id":"07a1e7f8091a2b3c","type":"text","x":10,"y":445,"width":350,"height":80,"color":"3","text":"Regla: el más específico gana, **faceta por faceta** — \"C dentro de B\". viewSnapshot() despoja UI-state (lección proto)"},
		{"id":"18b2f8091a2b3c4d","type":"group","x":450,"y":-60,"width":460,"height":520,"label":"Pipeline de estilo","color":"6"},
		{"id":"29c3091a2b3c4d5e","type":"text","x":470,"y":-20,"width":420,"height":80,"text":"Componente headless (bits-ui de verdad) — identidad `data-vm-*`, cero estilo propio"},
		{"id":"3ad41a2b3c4d5e6f","type":"text","x":470,"y":80,"width":420,"height":80,"text":"Vocabulario de clases POR preset — native: clases Obsidian reales · polish: `vm-*`"},
		{"id":"4be52b3c4d5e6f70","type":"text","x":470,"y":180,"width":420,"height":80,"text":"Pseudo-snippets CSS (= la faceta style) — el usuario los exporta a snippet `.css` real"},
		{"id":"5cf63c4d5e6f7081","type":"text","x":470,"y":280,"width":420,"height":70,"color":"4","text":"Lenguaje de diseño Obsidian preservado — anti UI-fuera-de-lenguaje (humana o de agente IA)"},
		{"id":"6d074d5e6f708192","type":"text","x":470,"y":370,"width":420,"height":70,"text":"Tokens `--vm-*` puenteados a vars de Obsidian (capa 0-B ya existente)"},
		{"id":"7e185e6f70819203","type":"group","x":950,"y":-60,"width":500,"height":580,"label":"Decisiones + next (grill EN CURSO)","color":"3"},
		{"id":"8f296f7081920314","type":"text","x":970,"y":-20,"width":460,"height":90,"color":"3","text":"CONFIRMADO dev: **B con la razón de C** — facetas tipadas, resolución en cascada"},
		{"id":"903a708192031425","type":"text","x":970,"y":90,"width":460,"height":90,"color":"3","text":"CONFIRMADO dev: **bits-ui real** (headless) + componentes shadcn en versión no-opinionada para UPV"},
		{"id":"a14b819203142536","type":"text","x":970,"y":200,"width":460,"height":120,"color":"2","text":"EN CURSO: estrategia de clases — propuesta **4+3**: `data-vm-*` identidad + clases por preset (native = presetObsidian en DOM) + índice de clases nativas vs app.css (web-lab) en el Fragility Registry"},
		{"id":"b25c920314253647","type":"text","x":970,"y":340,"width":460,"height":90,"color":"2","text":"NEXT: matriz faceta × scope → payload `.scene` (CR-2) → semántica del queued batcher"},
		{"id":"c36d031425364758","type":"text","x":970,"y":450,"width":460,"height":60,"color":"2","text":"OPEN heredados: motor variables UPV (presetWind4 vs presetObsidian) · Workspace-profile"}
	],
